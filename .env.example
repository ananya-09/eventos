# GitHub OAuth App Credentials
# Use for user authentication via GitHub login
# Create an OAuth App at https://github.com/settings/developers
# Steps:
#   1. Go to https://github.com/settings/developers
#   2. Click 'New OAuth App'
#   3. Set Authorization callback URL to: http://localhost:3000/api/auth/callback/github
#   4. Copy CLIENT_ID and generate CLIENT_SECRET
# Required for: User login/signup flow with GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Personal Access Token (PAT)
# Create at https://github.com/settings/tokens
# Required scopes: repo, user, gist (adjust based on your needs)
# Use for accessing GitHub API on behalf of your app
GITHUB_TOKEN=your_github_token

# NextAuth Secret (Session Encryption Key)
# Critical for security: encrypts session tokens and cookies
# Generate with: openssl rand -base64 32
# Keep this secret and never commit to version control
# Store in .env.local and .env.production with different values
# Required for: Session security, CSRF protection, token encryption
NEXTAUTH_SECRET=your_nextauth_secret

# The base URL of your app
NEXTAUTH_URL=http://localhost:3000
